# Copy this file to .env for local development.
VITE_APP_TITLE=MediaChips
VITE_APP_VERSION=1.0.0
VITE_API_URL=http://localhost:3000
VITE_LICENSE_API_URL=https://mediachips.app/wp-json/mediachips/v1/license
# Optional fallback for ThePornDB (prefer Settings → Adult → API key)
# https://theporndb.net/user/api-tokens
TPDB_API_KEY=

# --- Google Drive (also configurable in Settings → Connections) (API/Electron process only; never put secrets in the renderer) ---
# Without client id/secret, Google Drive is shown as not configured.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Must match an Authorized redirect URI in Google Cloud Console.
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:12321/api/drive/oauth/callback
# Force mock even if credentials are present (useful for tests).
# MEDIA_CHIPS_DRIVE_MOCK=1
# Optional override for token JSON path (default: private host-local data directory).
# MEDIA_CHIPS_DRIVE_TOKEN_PATH=
