# Copy this file to .env for local development.
VITE_APP_TITLE=MediaChips
VITE_APP_VERSION=1.0.0
VITE_API_URL=http://localhost:3000
VITE_LICENSE_API_URL=https://mediachips.app/wp-json/mediachips/v1/license
# Optional fallback for ThePornDB (prefer Settings → Adult → API key)
# https://theporndb.net/user/api-tokens
TPDB_API_KEY=

# --- Google Drive (also configurable in Settings → Connections) (API/Electron process only; never put secrets in the renderer) ---
# Without client id/secret, Google Drive is shown as not configured.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Must match an Authorized redirect URI in Google Cloud Console. A loopback address with a port
# other than the API port is ignored (the current API port is used automatically).
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:12321/api/drive/oauth/callback
# Force mock even if credentials are present (useful for tests).
# MEDIA_CHIPS_DRIVE_MOCK=1
# Optional override for token JSON path (default: private host-local data directory).
# MEDIA_CHIPS_DRIVE_TOKEN_PATH=

# --- Cloud accounts: Google Drive, OneDrive, Dropbox (API/Electron process only; never put secrets in the renderer) ---
# Optional "Connect" button with server-side OAuth clients. Each provider shows up
# in quick connect when its client id + secret and the redirect URI are all set and
# the redirect URI points to this API (a public URL, or loopback on the API port).
# Without these, enter your own OAuth client in the account's advanced settings;
# extra Google Drive accounts without a client id reuse the main Google Drive client above.
# On a NAS/Docker the sign-in finishes by pasting the return link, so no public address is needed.
# MEDIA_CHIPS_CLOUD_REDIRECT_URI=https://mediachips.example/api/cloud-accounts/oauth/callback
# MEDIA_CHIPS_CLOUD_GOOGLE_CLIENT_ID=
# MEDIA_CHIPS_CLOUD_GOOGLE_CLIENT_SECRET=
# MEDIA_CHIPS_CLOUD_ONEDRIVE_CLIENT_ID=
# MEDIA_CHIPS_CLOUD_ONEDRIVE_CLIENT_SECRET=
# MEDIA_CHIPS_CLOUD_DROPBOX_CLIENT_ID=
# MEDIA_CHIPS_CLOUD_DROPBOX_CLIENT_SECRET=
